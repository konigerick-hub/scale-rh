# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. .env.local NUNCA vai para o git.
# ---------------------------------------------------------------------------

# Postgres. Em produção use a connection string COM POOLER do provedor.
# `sslmode=verify-full` valida também o hostname do certificado — não baixe
# para `require` em produção, isso aceita certificado de qualquer servidor.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=verify-full"

# Só para Postgres local em desenvolvimento, que não tem TLS.
# Deixe VAZIO ou remova em produção.
DATABASE_SSL=""

# Segredo de assinatura da sessão. Mínimo 32 caracteres.
# Gere com:  openssl rand -base64 48
# Trocar este valor invalida todas as sessões ativas (útil em incidente).
SESSION_SECRET=""

# Storage privado dos contratos em PDF (fase 2).
# BLOB_READ_WRITE_TOKEN=""
